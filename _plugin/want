    SELECT
        au.sapid        AS bsi_id,
        au.name         AS bsi_name,
        lum.userloginid AS engineer_id,
        lum.locusername AS engineer_name,

        -- Grand Total (all statuses)
        COUNT(jd.job_id)    AS grand_total,

        -- Status wise totals
        SUM(CASE WHEN jd.status = '2'  THEN 1 ELSE 0 END) AS assigned_total,
        SUM(CASE WHEN jd.status = '3'  THEN 1 ELSE 0 END) AS pna_total,
        SUM(CASE WHEN jd.status = '7'  THEN 1 ELSE 0 END) AS wip_total,
        SUM(CASE WHEN jd.status = '81' THEN 1 ELSE 0 END) AS replacement_total,

        -- Assigned - Bucket wise
        SUM(CASE WHEN jd.status='2' AND DATEDIFF(NOW(),jd.open_date) <= 1               THEN 1 ELSE 0 END) AS assigned_b1,
        SUM(CASE WHEN jd.status='2' AND DATEDIFF(NOW(),jd.open_date) = 2                THEN 1 ELSE 0 END) AS assigned_b2,
        SUM(CASE WHEN jd.status='2' AND DATEDIFF(NOW(),jd.open_date) BETWEEN 3  AND 5   THEN 1 ELSE 0 END) AS assigned_b3,
        SUM(CASE WHEN jd.status='2' AND DATEDIFF(NOW(),jd.open_date) BETWEEN 6  AND 10  THEN 1 ELSE 0 END) AS assigned_b4,
        SUM(CASE WHEN jd.status='2' AND DATEDIFF(NOW(),jd.open_date) BETWEEN 11 AND 15  THEN 1 ELSE 0 END) AS assigned_b5,
        SUM(CASE WHEN jd.status='2' AND DATEDIFF(NOW(),jd.open_date) >= 16              THEN 1 ELSE 0 END) AS assigned_b6,

        -- Replacement - Bucket wise
        SUM(CASE WHEN jd.status='81' AND DATEDIFF(NOW(),jd.open_date) <= 1              THEN 1 ELSE 0 END) AS replacement_b1,
        SUM(CASE WHEN jd.status='81' AND DATEDIFF(NOW(),jd.open_date) = 2               THEN 1 ELSE 0 END) AS replacement_b2,
        SUM(CASE WHEN jd.status='81' AND DATEDIFF(NOW(),jd.open_date) BETWEEN 3  AND 5  THEN 1 ELSE 0 END) AS replacement_b3,
        SUM(CASE WHEN jd.status='81' AND DATEDIFF(NOW(),jd.open_date) BETWEEN 6  AND 10 THEN 1 ELSE 0 END) AS replacement_b4,
        SUM(CASE WHEN jd.status='81' AND DATEDIFF(NOW(),jd.open_date) BETWEEN 11 AND 15 THEN 1 ELSE 0 END) AS replacement_b5,
        SUM(CASE WHEN jd.status='81' AND DATEDIFF(NOW(),jd.open_date) >= 16             THEN 1 ELSE 0 END) AS replacement_b6,

        -- WIP - Bucket wise
        SUM(CASE WHEN jd.status='7' AND DATEDIFF(NOW(),jd.open_date) <= 1               THEN 1 ELSE 0 END) AS wip_b1,
        SUM(CASE WHEN jd.status='7' AND DATEDIFF(NOW(),jd.open_date) = 2                THEN 1 ELSE 0 END) AS wip_b2,
