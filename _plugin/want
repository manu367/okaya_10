        SUM(CASE WHEN jd.status='7' AND DATEDIFF(NOW(),jd.open_date) BETWEEN 11 AND 15  THEN 1 ELSE 0 END) AS wip_b5,
        SUM(CASE WHEN jd.status='7' AND DATEDIFF(NOW(),jd.open_date) >= 16              THEN 1 ELSE 0 END) AS wip_b6,

