
SELECT COUNT(*) AS total_rows
FROM (
    SELECT
        au.sapid           AS bsi_id,
        au.username        AS bsi_username,
        au.name            AS bsi_name,
        zone_info.zonename AS zone,
        lum.userloginid    AS engineer_id,
        lum.locusername    AS engineer_name,
        DATEDIFF(NOW(), jd.open_date) AS aging_days,
        CASE jd.status
            WHEN '2'  THEN 'Assigned'
            WHEN '3'  THEN 'PNA'
            WHEN '7'  THEN 'WIP'
            WHEN '81' THEN 'Replacement'
            ELSE 'Other'
        END AS status_label,
        jd.job_no,
        jd.open_date,
        jd.status AS raw_status

    FROM locationuser_master lum

    JOIN jobsheet_data jd
        ON jd.eng_id = lum.userloginid
        AND jd.status IN ('0','1','2','3','7','81')

    JOIN (
        SELECT
            sapid,
            MIN(username) AS username,
            MIN(name)     AS name
        FROM admin_users
        WHERE status = '1'
          AND designation_id = '45'
        GROUP BY sapid
    ) au ON au.sapid = lum.mapped_bsi

    LEFT JOIN (
        SELECT
            ar.userid,
            MIN(zm.zonename) AS zonename
        FROM access_region ar
        JOIN state_master sm ON sm.stateid = ar.stateid
        JOIN zone_master zm  ON zm.zoneid  = sm.zoneid
        WHERE ar.status = 'Y'
        GROUP BY ar.userid
    ) zone_info ON zone_info.userid = au.username

    GROUP BY
        au.sapid,
        au.username,
        au.name,
        zone_info.zonename,
        lum.userloginid,
        lum.locusername,
        jd.job_no,
        jd.open_date,
        jd.status

) AS counted;

================================ give All Data Ageing based |==================
SELECT
    @row_num := @row_num + 1 AS sr_no,
    main.*
FROM (
    SELECT
        au.sapid           AS bsi_id,
        au.username        AS bsi_username,
        au.name            AS bsi_name,
        zone_info.zonename AS zone,
        lum.userloginid    AS engineer_id,
        lum.locusername    AS engineer_name,
        DATEDIFF(NOW(), jd.open_date) AS aging_days,
        CASE jd.status
            WHEN '2'  THEN 'Assigned'
            WHEN '3'  THEN 'PNA'
            WHEN '7'  THEN 'WIP'
            WHEN '81' THEN 'Replacement'
            ELSE 'Other'
        END AS status_label,
        CASE
            WHEN DATEDIFF(NOW(), jd.open_date) <= 1              THEN '0-1 Days'
            WHEN DATEDIFF(NOW(), jd.open_date) = 2               THEN '2 Days'
            WHEN DATEDIFF(NOW(), jd.open_date) BETWEEN 3  AND 5  THEN '3-5 Days'
            WHEN DATEDIFF(NOW(), jd.open_date) BETWEEN 6  AND 10 THEN '6-10 Days'
            WHEN DATEDIFF(NOW(), jd.open_date) BETWEEN 11 AND 15 THEN '11-15 Days'
            WHEN DATEDIFF(NOW(), jd.open_date) >= 16             THEN 'Above 15'
            ELSE 'Unknown'
        END AS aging_bucket,
        jd.job_no,
        jd.open_date,
        jd.status AS raw_status

    FROM locationuser_master lum

    JOIN jobsheet_data jd
        ON jd.eng_id = lum.userloginid
        AND jd.status IN ('0','1','2','3','7','81')

    -- ✅ FIX: LIMIT 1 hata diya, per sapid ek hi username lo MIN se
    JOIN (
        SELECT
            sapid,
            MIN(username) AS username,   -- ✅ per sapid sirf 1 username
            MIN(name)     AS name
        FROM admin_users
        WHERE status = '1'
          AND designation_id = '45'      -- ✅ sirf BSI designation wale
        GROUP BY sapid                   -- ✅ har BSI ke liye ek row
    ) au ON au.sapid = lum.mapped_bsi

    LEFT JOIN (
        SELECT
            ar.userid,
            MIN(zm.zonename) AS zonename
        FROM access_region ar
        JOIN state_master sm ON sm.stateid = ar.stateid
        JOIN zone_master zm  ON zm.zoneid  = sm.zoneid
        WHERE ar.status = 'Y'
        GROUP BY ar.userid
    ) zone_info ON zone_info.userid = au.username

    -- ✅ koi WHERE filter nahi - sab BSI ke sab jobs
    GROUP BY
        au.sapid,
        au.username,
        au.name,
        zone_info.zonename,
        lum.userloginid,
        lum.locusername,
        jd.job_no,
        jd.open_date,
        jd.status

    ORDER BY au.sapid ASC, aging_days ASC

) main,
(SELECT @row_num := 0) AS counter;



